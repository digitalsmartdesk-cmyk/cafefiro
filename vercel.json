{
  "buildCommand": "pnpm --filter storefront build",
  "outputDirectory": "storefront/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/backend/:path*", "destination": "https://api.cafefiro.in/:path*" }
  ],
  "env": {
    "NEXT_PUBLIC_MEDUSA_BACKEND_URL": "@medusa-backend-url",
    "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY": "@medusa-publishable-key",
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": "@razorpay-key-id",
    "RAZORPAY_KEY_ID": "@razorpay-key-id",
    "RAZORPAY_KEY_SECRET": "@razorpay-key-secret",
    "NEXTAUTH_SECRET": "@nextauth-secret",
    "NEXTAUTH_URL": "@nextauth-url"
  }
}
